<% if comments.present? %>
  <ul class="uk-comment-list" uk-accordion='multiple: true; toggle: > .uk-accordion-title:not(.a-hover)'>
    <% comments.each do |comment| %>
      <li class="uk-open" id="<%= comment.data['id'] %>">
        <div class="uk-accordion-title hn-cursor-pointer">
          <%= comment.data['by'] %>
          <% comment_time = Time.at(comment.data['time']).utc %>
          <a href="#<%= comment.data['id'] %>" class="uk-text-meta comment" title="<%= comment_time %>">
            <time datetime="<%= comment.data['time'] %>" class="ago"></time>
          </a>
        </div>

        <div class="uk-accordion-content">
          <article class="uk-comment">
            <%= comment.data['text'] %>
          </article>

          <% replies = comment.comments %>
          <%= erb :_comments, layout: false, locals: { comments: replies, parent: comment } %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<% if comments&.missing? %>
  <p class="uk-text-meta uk-text-italic">
    <%= comments.missing_count %>
    <%= comments.missing_count == 1 ? 'comment is' : 'comments are' %>
    not cached yet &mdash;
    <a href="<%= parent.comments_url %>">read on Hacker News</a>.
  </p>
<% end %>
