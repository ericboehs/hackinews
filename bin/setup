#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> Installing gems"
bundle install

if [ ! -f .env.local ]; then
  echo "==> Creating .env.local from .env.example"
  cp .env.example .env.local
fi

# Keep host/user/port/query from DATABASE_URL; swap only the database name.
swap_db() {
  local url="$1"
  local new_db="$2"
  printf '%s\n' "$url" | sed -E "s#/[^/?]+(\\?.*)?\$#/${new_db}\\1#"
}

base_url="${DATABASE_URL:-postgres:///hackinews_development}"
dev_url="$(swap_db "$base_url" hackinews_development)"
test_url="$(swap_db "$base_url" hackinews_test)"

echo "==> Ensuring databases exist and running migrations"
DATABASE_URL="$dev_url" dbmate create
DATABASE_URL="$dev_url" dbmate up
DATABASE_URL="$test_url" dbmate create
DATABASE_URL="$test_url" dbmate up

echo
echo "Setup complete. Start the app with: bin/dev"
