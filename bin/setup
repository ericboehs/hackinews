#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> Installing gems"
bundle install

if [ ! -f .env.local ]; then
  echo "==> Creating .env.local from .env.example"
  cp .env.example .env.local
fi

# Exported DATABASE_URL wins; otherwise read it from .env.local.
if [ -z "${DATABASE_URL:-}" ] && [ -f .env.local ]; then
  DATABASE_URL="$(grep -E '^DATABASE_URL=' .env.local | tail -1 | cut -d= -f2- || true)"
  DATABASE_URL="${DATABASE_URL%\"}"
  DATABASE_URL="${DATABASE_URL#\"}"
  DATABASE_URL="${DATABASE_URL%\'}"
  DATABASE_URL="${DATABASE_URL#\'}"
  if [ -z "$DATABASE_URL" ]; then
    echo "ERROR: .env.local has no DATABASE_URL" >&2
    exit 1
  fi
fi

# Keep host/user/port/query from DATABASE_URL; swap only the database name.
swap_db() {
  local url="$1"
  local new_db="$2"
  printf '%s\n' "$url" | sed -E "s#/[^/?]+(\\?.*)?\$#/${new_db}\\1#"
}

# pg_dump 17+ emits directives PG16 cannot load.
sanitize_schema() {
  local file=db/schema.sql
  [ -f "$file" ] || return 0
  grep -v -e '^\\restrict ' -e '^\\unrestrict ' -e '^SET transaction_timeout' "$file" > "${file}.tmp"
  mv "${file}.tmp" "$file"
}

base_url="${DATABASE_URL:-postgres:///hackinews_development}"
dev_url="$(swap_db "$base_url" hackinews_development)"
test_url="$(swap_db "$base_url" hackinews_test)"

echo "==> Ensuring databases exist and running migrations"
# dbmate create fails when the DB already exists (exit 2). up will surface real errors.
DATABASE_URL="$dev_url" dbmate create || true
DATABASE_URL="$dev_url" dbmate up
sanitize_schema
DATABASE_URL="$test_url" dbmate create || true
DATABASE_URL="$test_url" dbmate up
sanitize_schema

echo
echo "Setup complete. Start the app with: bin/dev"
