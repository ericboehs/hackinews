#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> Installing gems"
bundle install

if [ ! -f .env.local ]; then
  echo "==> Creating .env.local from .env.example"
  cp .env.example .env.local
fi

ensure_db() {
  local name="$1"
  local exists
  exists="$(psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='${name}'")"
  if [ "$exists" = "1" ]; then
    echo "    ${name} already exists"
  else
    echo "    creating ${name}"
    createdb "$name"
  fi
}

echo "==> Ensuring databases exist"
ensure_db hackinews_development
ensure_db hackinews_test

echo "==> Running migrations"
DATABASE_URL=postgres:///hackinews_development dbmate up
DATABASE_URL=postgres:///hackinews_test dbmate up

echo
echo "Setup complete. Start the app with: bin/dev"
