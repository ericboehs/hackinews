# Local PostgreSQL. Copy this file to .env.local (loaded first, overrides .env).
DATABASE_URL=postgres:///hackinews_development

# Optional
# PORT=3000
# WORKER_INTERVAL=300
# Least-recently-updated items re-checked each cycle. HN's updates feed can
# drop changes between polls, so this sweep is what guarantees the cache
# eventually converges. Raise it to converge faster, lower it to cut API load.
# RECONCILE_BATCH=500
# GA_TRACKING_ID=
